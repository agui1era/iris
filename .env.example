# Alibaba Model Studio / DashScope
# La clave y la URL deben pertenecer a la misma región.
DASHSCOPE_API_KEY=sk-ws-reemplazar
DASHSCOPE_BASE_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1
# Alternativa: comenta las dos variables anteriores y usa un archivo fuera del
# repositorio, o dentro de .secrets/ (ignorado), con permisos 0600.
# DASHSCOPE_CREDENTIALS_CSV=".secrets/Default Workspace-apiKey-.csv"
DASHSCOPE_MODEL=qwen3.6-flash
# Entre 1 y 300 segundos.
DASHSCOPE_TIMEOUT_SECONDS=45
DASHSCOPE_MAX_RETRIES=3
DASHSCOPE_MAX_COMPLETION_TOKENS=512

# El dashboard administra proveedor, modelo y timeouts. La API key se persiste
# en SQLite y es write-only: nunca se devuelve al navegador; vacío conserva la actual.

# Configuración global de imagen. Los readers RTSP funcionan en paralelo, pero
# las llamadas a Alibaba se serializan globalmente (máximo una activa).
FRAME_WIDTH=640
FRAME_HEIGHT=360
JPEG_QUALITY=82
MAX_API_CALLS_PER_MINUTE=60
MAX_FRAME_PIXELS=2621440
FRAME_STALE_AFTER_SECONDS=15

# Gating por variación (opcional). En 0 (default) cada frame fresco se analiza
# siempre. Por encima de 0, un frame que varía menos que este % respecto al
# último frame REALMENTE analizado se omite (ahorra llamadas a Alibaba) --
# salvo que la última severidad confirmada de esa cámara sea medium o
# superior, en cuyo caso siempre se reanaliza (una situación crítica estable
# visualmente nunca deja de revisarse). Editable también desde Administración.
CHANGE_THRESHOLD_PERCENT=0
# Afinación interna del índice de variación (sólo por entorno, no en el
# dashboard): delta mínimo 0-255 por píxel y resolución de la comparación.
PIXEL_CHANGE_THRESHOLD=24
DELTA_WIDTH=160
DELTA_HEIGHT=90

# Captura RTSP y reconexión.
RTSP_TRANSPORT=tcp
RTSP_RECONNECT_SECONDS=5
RTSP_OPEN_TIMEOUT_MS=10000
RTSP_READ_TIMEOUT_MS=10000

# Evidencia y eventos.
SAVE_CAPTURES=true
CAPTURE_DIR=data/captures
# Además de las capturas históricas (con gating por severidad, ver abajo),
# iris-api expone GET /cameras/{id}/latest-frame: el último frame
# enviado al modelo de visión por cámara, sobrescrito antes de cada llamada.
# Funciona aunque Alibaba falle y aunque SAVE_CAPTURES=false (es una vista
# operativa liviana, no el mecanismo de retención de evidencia) y aunque
# MONGO_URI no esté configurada. Es visible para cualquier rol autenticado
# del dashboard, no sólo admin -- mismo nivel de acceso que las imágenes de
# detecciones históricas.
CAPTURE_RETENTION_DAYS=7
CAPTURE_MAX_FILES_PER_CAMERA=1000
EVENTS_JSONL_PATH=data/events.jsonl
EVENTS_MAX_BYTES=50000000
EVENTS_BACKUP_COUNT=5
LOG_LEVEL=INFO

# Todo análisis se registra siempre en el historial de eventos (JSONL/Mongo),
# tenga o no severidad relevante. SAVE_IMAGE_MIN_SEVERITY sólo decide si,
# además, se guarda el JPEG en disco: la imagen se persiste únicamente cuando
# la severidad del análisis alcanza o supera este umbral. Los análisis por
# debajo del umbral (y los análisis fallidos) quedan igualmente en el
# historial, pero con snapshot_path en null.
# Valores válidos, de menor a mayor: none, info, low, medium, high, critical.
SAVE_IMAGE_MIN_SEVERITY=high

# Cámaras dinámicas: CAM1, CAM2, CAM3... Se permiten canales con huecos.
# IRIS puede leer VITE_RTSP_URL_CAMn sólo para migración. No guardes credenciales
# en VITE_*: Vite puede incluirlas en el bundle visible desde el navegador.
# Por cámara se configura nombre, URL RTSP, prompt e intervalo (mínimo 10s).
CAM1_NAME=Dormitorio
CAM1_RTSP_URL=rtsp://usuario:clave@192.168.1.101:554/stream1
CAM1_PROMPT=Detecta caídas, intentos de levantarse con dificultad y riesgos visibles alrededor de la cama.
CAM1_POLL_INTERVAL_SECONDS=30

CAM2_NAME=Living
CAM2_RTSP_URL=rtsp://usuario:clave@192.168.1.102:554/stream1
CAM2_PROMPT=Detecta caídas, obstáculos, posturas inusuales y situaciones que requieran revisión de un cuidador.
CAM2_POLL_INTERVAL_SECONDS=45

# Las cámaras también pueden agregarse, editarse y eliminarse desde la API del
# dashboard (POST/PATCH/DELETE /admin/cameras, rol admin). iris-monitor observa
# la revisión SQLite y aplica los cambios sin solapar conexiones RTSP.

# Almacén de configuración en SQLite (recomendado en producción).
# Mantener credenciales en un .env de texto plano es cómodo para desarrollo,
# pero en producción conviene moverlas a un archivo SQLite con permisos 0600.
# Ejecuta esta migración una sola vez:
#   uv run iris-monitor --migrate-env-to-sqlite
# Esto valida el archivo completo e importa una sola vez únicamente claves
# reconocidas por IRIS. Se niega a sobrescribir un store ya inicializado.
# SQLite tiene prioridad para las claves persistidas; el entorno sigue siendo
# fallback. Una base creada sólo por iris-users no oculta el .env.
# IRIS_CONFIG_DB=data/config.db

# MongoDB (opcional): sink adicional de detecciones.
# Si defines MONGO_URI, cada evento de análisis se escribe además en MongoDB,
# sin dejar de escribirse en el JSONL local (EVENTS_JSONL_PATH) como respaldo.
# Si MONGO_URI no está definida, sólo se usa el JSONL local.
# MONGO_URI=mongodb://usuario:clave@localhost:27017
# MONGO_DATABASE=iris
# MONGO_DETECTION_COLLECTION=iris_detections
# Aliases compatibles con Sentinex: SENTINEX_MONGO_URI, SENTINEX_MONGO_DB y
# SENTINEX_MONGO_DETECTION_COLLECTION.

# MONGO_URI, MONGO_DATABASE y MONGO_DETECTION_COLLECTION NO se gestionan
# desde el dashboard: se editan sólo acá o en el SQLite de configuración
# directamente. La configuración de DashScope sí tiene editor propio.

# Telegram (opcional): notifica foto + texto cuando un análisis supera el
# notification_threshold de esa cámara (editable por cámara en Administración,
# default "high"). Sin TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID, el envío queda
# desactivado. ENABLE_TELEGRAM (default true) es un interruptor aparte: en
# false, guarda las credenciales pero no envía nada. Un único bot/chat global,
# sin enrutamiento distinto por cámara todavía.
# ENABLE_TELEGRAM=true
# TELEGRAM_BOT_TOKEN=123456:AAExampleTokenNoEsReal
# TELEGRAM_CHAT_ID=-1001234567890

# API del dashboard (iris-api): proceso separado de iris-monitor, expone el
# historial de detecciones (MongoDB) y la administración de usuarios (SQLite)
# vía HTTP con autenticación JWT. iris-monitor nunca lee estas variables.
#
# AUTH_JWT_SECRET es obligatoria para iris-api (no tiene valor por defecto):
# el proceso se niega a arrancar sin ella. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_JWT_SECRET=reemplazar-con-un-secreto-generado
# Minutos de validez de cada token emitido en /auth/login (mínimo 5).
AUTH_JWT_EXPIRES_MINUTES=480
# Orígenes permitidos por CORS, separados por coma. Nunca uses "*" en
# producción: sólo agrega los orígenes reales del dashboard.
API_CORS_ORIGINS=http://localhost:5173
API_HOST=0.0.0.0
API_PORT=8000
